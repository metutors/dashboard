JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_PROJECT_NAME=
JIRA_CACHE_MINUTES=5

# Ignore Jira board Backlog issues (no sprint assigned). Set false to include them.
JIRA_EXCLUDE_BACKLOG=true

# Optional custom fields (discover via GET /rest/api/3/field)
JIRA_MODULE_FIELD=
JIRA_TICKET_SOURCE_FIELD=

# Comma-separated module labels used when JIRA_MODULE_FIELD is unset
JIRA_MODULE_LABELS=

# Issue type names
JIRA_BUG_TYPES=Bug
JIRA_TASK_TYPES=Task

# Status name mappings (comma-separated aliases per category)
JIRA_STATUS_DONE=Done,Closed,Resolved
JIRA_STATUS_IN_PROGRESS=In Progress
JIRA_STATUS_ON_HOLD=On Hold
JIRA_STATUS_READY_FOR_QA=Ready for QA
JIRA_STATUS_TODO=To Do,Open,Backlog,Re-opened,Changed by Client

# Team membership (comma-separated display names)
JIRA_BACKEND_USERS=
JIRA_FRONTEND_USERS=
JIRA_BACKEND_LABEL=BACKEND
JIRA_FRONTEND_LABEL=FRONTEND
